# Copy this file to .env and fill in your own values.
# Keep .env private. Do not commit real keys.

# Aliyun Bailian / DashScope, used by Paraformer V2 ASR.
DASHSCOPE_API_KEY=

# DeepSeek, used for transcript post-processing.
DEEPSEEK_API_KEY=

# Aliyun OSS, used to upload audio and generate temporary HTTPS URLs for ASR.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
